<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI-слой: Shell-навигация, страницы XAML, DI-композиция, resx-локализация.
    Требует workload `maui`. В headless-Linux CI (без Android SDK) НЕ собирается —
    поэтому в build-and-test.yml включается только при наличии workloads на runner.
  -->
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>DesignPatterns.App</RootNamespace>
    <ApplicationTitle>Design Patterns</ApplicationTitle>
    <ApplicationId>com.designpatterns.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesignPatterns.Core\DesignPatterns.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>


</Project>
