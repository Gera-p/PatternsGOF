<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DesignPatterns.Core.ViewModels;assembly=DesignPatterns.Core"
             x:Class="DesignPatterns.App.MainPage"
             x:Name="ThisPage"
             x:DataType="vm:MainPageViewModel">

    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="12">
            <Entry Placeholder="{Binding SearchPlaceholder}"
                   Text="{Binding SearchQuery}"
                   WidthRequest="200"
                   AutomationId="SearchInput" />
            <Button Text="{Binding LanguageButtonText}"
                    Command="{Binding ToggleLanguageCommand}"
                    AutomationId="LanguageToggle" />
            <Button Text="★"
                    Command="{Binding OpenFavoritesCommand}"
                    AutomationId="FavoritesButton" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Categories}"
                        AutomationId="CategoriesList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="16">
                        <Label Text="{Binding Id, Converter={StaticResource IdentityConverter}}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Description.Ru}" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
